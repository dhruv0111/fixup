# Copy to .env and replace placeholders. Never commit real environment files.
# npm run setup:local generates random local credentials instead.
DATABASE_URL=postgresql://fixup:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:55432/fixup_dev
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_URL=http://127.0.0.1:3000
APP_ENV=development
# file is LOCAL ONLY. Production requires smtp and HTTPS.
MAIL_MODE=file
MAIL_FROM=FIXUP <noreply@example.invalid>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
# Configure only a header your deployment proxy overwrites, never arbitrary client input.
TRUSTED_IP_HEADER=
NEXT_TELEMETRY_DISABLED=1
