generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  DEALER
  SALES_REP
  ADMIN
  SUPER_ADMIN
}

enum DealerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CustomerCategory {
  RETAIL
  APPROVED_DEALER
}

model User {
  id                   String              @id
  name                 String
  email                String              @unique
  emailVerified        Boolean             @default(false)
  twoFactorEnabled     Boolean             @default(false)
  image                String?
  role                 Role                @default(CUSTOMER)
  active               Boolean             @default(true)
  managementVersion    Int                 @default(0)
  profileProvisionedAt DateTime?           @db.Timestamptz(3)
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @db.Timestamptz(3)
  sessions             Session[]
  accounts             Account[]
  customer             Customer?
  auditLogs            AuditLog[]
  dealerReviews        DealerProfile[]     @relation("DealerReviewer")
  stockMovements       StockMovement[]
  paymentSubmissions   PaymentSubmission[]
  paymentRecords       PaymentRecord[]
  twoFactor            TwoFactor?

  @@index([role, active])
}

model Session {
  id            String    @id
  token         String    @unique
  expiresAt     DateTime  @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  ipAddress     String?
  userAgent     String?
  userId        String
  mfaVerifiedAt DateTime? @db.Timestamptz(3)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TwoFactor {
  id                      String       @id
  userId                  String       @unique
  user                    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret                  String
  backupCodes             String
  verified                Boolean      @default(false)
  failedVerificationCount Int          @default(0)
  lockedUntil             DateTime?    @db.Timestamptz(3)
  usedCodes               MfaCodeUse[]
}

// Hashed replay evidence (checked for 120 seconds); raw codes are never stored.
// Records are retained; this migration does not delete audit or test evidence.
model MfaCodeUse {
  id       String    @id @default(cuid())
  factorId String
  factor   TwoFactor @relation(fields: [factorId], references: [id], onDelete: Cascade)
  digest   String
  usedAt   DateTime  @default(now()) @db.Timestamptz(3)

  @@index([factorId, usedAt])
}

// Required by Better Auth: credential passwords are library-managed here, not in User.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Customer {
  id           String           @id @default(cuid())
  userId       String           @unique
  businessName String?
  phone        String?
  category     CustomerCategory @default(RETAIL)
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(3)
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  addresses    Address[]
  dealer       DealerProfile?
  cartItems    CartItem[]
  salesOrders  SalesOrder[]
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  recipient  String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("IN")
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model DealerProfile {
  id             String       @id @default(cuid())
  customerId     String       @unique
  businessName   String
  contactName    String
  businessType   String?
  gstin          String?      @unique
  expectedVolume String?
  phone          String       @default("")
  email          String       @default("")
  address        String       @default("")
  city           String       @default("")
  state          String       @default("")
  postalCode     String       @default("")
  message        String       @default("")
  version        Int          @default(0)
  status         DealerStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?    @db.Timestamptz(3)
  reviewReason   String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  reviewedBy     User?        @relation("DealerReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reviewedById])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  reason     String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

model BusinessSettings {
  id          String   @id @default("singleton")
  displayName String   @default("FIXUP")
  timezone    String   @default("Asia/Kolkata")
  currency    String   @default("INR")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String    @default("")
  active      Boolean   @default(true)
  isDemo      Boolean   @default(false)
  products    Product[]
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
}

model Product {
  id                  String            @id @default(cuid())
  name                String
  slug                String            @unique
  sku                 String?           @unique
  brand               String
  packSize            String
  summary             String
  description         String
  active              Boolean           @default(true)
  published           Boolean           @default(false)
  featured            Boolean           @default(false)
  isDemo              Boolean           @default(false)
  contentApproved     Boolean           @default(false)
  approvalReference   String            @default("")
  applications        String[]          @default([])
  materials           String[]          @default([])
  specifications      Json              @default("[]")
  storageInstructions String            @default("")
  availability        String            @default("ENQUIRE")
  sourceNotes         String            @default("")
  categoryId          String
  category            Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images              ProductImage[]
  documents           ProductDocument[]
  enquiries           Enquiry[]
  variants            ProductVariant[]
  prices              PriceEntry[]
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)

  @@index([active, published, isDemo])
  @@index([categoryId])
}

model ProductVariant {
  id                String              @id @default(cuid())
  productId         String
  product           Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  name              String
  packSize          String
  sku               String?             @unique
  active            Boolean             @default(true)
  published         Boolean             @default(false)
  contentApproved   Boolean             @default(false)
  approvalReference String              @default("")
  imageUrl          String?
  imageAlt          String              @default("")
  imageApproved     Boolean             @default(false)
  representative    Boolean             @default(true)
  mrpPaise          Int?
  mrpConfirmed      Boolean             @default(false)
  mrpReferencePaise Int?
  mrpReferenceNote  String              @default("")
  version           Int                 @default(0)
  prices            PriceEntry[]
  suppliers         SupplierVariant[]
  purchaseLines     PurchaseOrderLine[]
  stockLots         StockLot[]
  stockMovements    StockMovement[]
  stockSetting      StockSetting?
  cartItems         CartItem[]
  salesLines        SalesOrderLine[]
  reservations      StockReservation[]
  reservationEvents ReservationEvent[]
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)

  @@unique([productId, packSize])
  @@index([productId, active, published])
}

model PriceList {
  id         String              @id @default(cuid())
  name       String
  currency   String              @default("INR")
  active     Boolean             @default(false)
  version    Int                 @default(0)
  entries    PriceEntry[]
  categories CategoryPriceList[]
  createdAt  DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @db.Timestamptz(3)
}

model CategoryPriceList {
  category    CustomerCategory @id
  priceListId String?
  priceList   PriceList?       @relation(fields: [priceListId], references: [id], onDelete: Restrict)
  version     Int              @default(0)
}

model PriceEntry {
  id          String          @id @default(cuid())
  priceListId String
  priceList   PriceList       @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?        @relation(fields: [productId], references: [id], onDelete: Restrict)
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Restrict)
  amountPaise Int

  @@unique([priceListId, productId])
  @@unique([priceListId, variantId])
}

// Administrative change history. Never returned from customer/public pricing APIs.
model ManagementEvent {
  id         String   @id @default(cuid())
  actorId    String
  entityType String
  entityId   String
  reason     String
  before     Json
  after      Json
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  approved  Boolean @default(false)
  sortOrder Int     @default(0)

  @@index([productId])
}

model ProductDocument {
  id               String  @id @default(cuid())
  productId        String
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  title            String
  kind             String
  publicUrl        String?
  privateReference String  @default("")
  approved         Boolean @default(false)
  visibility       String  @default("PRIVATE")

  @@index([productId])
}

model WebsiteContent {
  id            String   @id @default("singleton")
  phone         String   @default("")
  whatsapp      String   @default("")
  email         String   @default("")
  address       String   @default("")
  workingHours  String   @default("")
  aboutText     String   @default("")
  aboutApproved Boolean  @default(false)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  published Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Policy {
  id        String   @id
  title     String
  body      String
  approved  Boolean  @default(false)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Enquiry {
  id            String   @id @default(cuid())
  requestId     String   @unique
  payloadDigest String
  kind          String
  name          String
  businessName  String   @default("")
  phone         String
  email         String   @default("")
  address       String   @default("")
  city          String   @default("")
  postalCode    String   @default("")
  businessType  String   @default("")
  gstin         String   @default("")
  quantity      String   @default("")
  location      String   @default("")
  message       String   @default("")
  consentAt     DateTime @default(now()) @db.Timestamptz(3)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([kind, createdAt])
  @@index([payloadDigest, createdAt])
}

model Supplier {
  id           String            @id @default(cuid())
  name         String
  contactName  String
  phone        String
  email        String
  address      String
  city         String
  state        String
  postalCode   String
  gstin        String?           @unique
  supplierType String
  paymentTerms String
  notes        String            @default("")
  status       String            @default("ACTIVE")
  identityKey  String            @unique
  version      Int               @default(0)
  variants     SupplierVariant[]
  purchases    PurchaseOrder[]
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)

  @@index([status, name])
}

model SupplierVariant {
  supplierId String
  variantId  String
  supplier   Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@id([supplierId, variantId])
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  number           String              @unique @default(dbgenerated("('FIX-PO-'::text || lpad((nextval('fixup_po_number'::regclass))::text, 8, '0'::text))"))
  requestId        String              @unique
  payloadDigest    String
  supplierId       String
  supplier         Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierSnapshot Json
  status           String              @default("DRAFT")
  expectedDate     DateTime?           @db.Date
  notes            String              @default("")
  subtotalPaise    Int
  discountPaise    Int
  taxPaise         Int
  totalPaise       Int
  version          Int                 @default(0)
  createdById      String
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)
  lines            PurchaseOrderLine[]
  receipts         GoodsReceipt[]

  @@index([supplierId, createdAt])
  @@index([status, createdAt])
}

model PurchaseOrderLine {
  id               String             @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  variantId        String
  variant          ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productName      String
  variantName      String
  packSize         String
  sku              String?
  quantity         Int
  receivedQuantity Int                @default(0)
  ratePaise        Int
  taxBps           Int
  discountPaise    Int
  subtotalPaise    Int
  taxPaise         Int
  totalPaise       Int
  receipts         GoodsReceiptLine[]

  @@unique([purchaseOrderId, variantId])
}

model GoodsReceipt {
  id               String             @id @default(cuid())
  number           String             @unique @default(dbgenerated("('FIX-GRN-'::text || lpad((nextval('fixup_grn_number'::regclass))::text, 8, '0'::text))"))
  requestId        String             @unique
  payloadDigest    String
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Restrict)
  status           String             @default("DRAFT")
  invoiceReference String
  notes            String             @default("")
  version          Int                @default(0)
  createdById      String
  completedById    String?
  completedAt      DateTime?          @db.Timestamptz(3)
  reversedById     String?
  reversedAt       DateTime?          @db.Timestamptz(3)
  correctionReason String?
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @db.Timestamptz(3)
  lines            GoodsReceiptLine[]

  @@index([purchaseOrderId, createdAt])
  @@index([status, createdAt])
}

model GoodsReceiptLine {
  id             String            @id @default(cuid())
  receiptId      String
  receipt        GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  purchaseLineId String
  purchaseLine   PurchaseOrderLine @relation(fields: [purchaseLineId], references: [id], onDelete: Restrict)
  quantity       Int
  batchNumber    String?
  manufacturedAt DateTime?         @db.Date
  expiresAt      DateTime?         @db.Date
  lot            StockLot?
  movements      StockMovement[]

  @@unique([receiptId, purchaseLineId])
}

model StockLot {
  id                  String               @id @default(cuid())
  variantId           String
  variant             ProductVariant       @relation(fields: [variantId], references: [id], onDelete: Restrict)
  receiptLineId       String?              @unique
  receiptLine         GoodsReceiptLine?    @relation(fields: [receiptLineId], references: [id], onDelete: Restrict)
  batchNumber         String?
  manufacturedAt      DateTime?            @db.Date
  expiresAt           DateTime?            @db.Date
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  movements           StockMovement[]
  dispatchAllocations DispatchAllocation[]
  cost                LotCost?

  @@unique([id, variantId])
  @@index([variantId, expiresAt])
}

model StockAdjustment {
  id            String         @id @default(cuid())
  requestId     String         @unique
  payloadDigest String
  kind          String
  reason        String
  actorId       String
  createdAt     DateTime       @default(now()) @db.Timestamptz(3)
  movement      StockMovement?
}

model StockMovement {
  id                   String              @id @default(cuid())
  variantId            String
  variant              ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  lotId                String
  lot                  StockLot            @relation(fields: [lotId, variantId], references: [id, variantId], onDelete: Restrict)
  kind                 String
  availableDelta       Int
  damagedDelta         Int                 @default(0)
  previousStock        Int                 @default(0)
  updatedStock         Int                 @default(0)
  previousDamaged      Int                 @default(0)
  updatedDamaged       Int                 @default(0)
  receiptLineId        String?
  receiptLine          GoodsReceiptLine?   @relation(fields: [receiptLineId], references: [id], onDelete: Restrict)
  adjustmentId         String?             @unique
  adjustment           StockAdjustment?    @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  dispatchAllocationId String?             @unique
  dispatchAllocation   DispatchAllocation? @relation(fields: [dispatchAllocationId], references: [id], onDelete: Restrict)
  dispatchReturnId     String?             @unique
  dispatchReturn       DispatchReturn?     @relation(fields: [dispatchReturnId], references: [id], onDelete: Restrict)
  reason               String
  actorId              String
  actor                User                @relation(fields: [actorId], references: [id], onDelete: Restrict)
  createdAt            DateTime            @default(now()) @db.Timestamptz(3)

  @@unique([receiptLineId, kind])
  @@index([variantId, createdAt])
  @@index([lotId, createdAt])
}

model StockSetting {
  variantId       String         @id
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  minimumQuantity Int?
  version         Int            @default(0)
}

model CartItem {
  customerId     String
  variantId      String
  customer       Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity       Int
  seenPricePaise Int
  seenCategory   String
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  @@id([customerId, variantId])
}

model SalesSettings {
  id                   String    @id @default("singleton")
  enabled              Boolean   @default(false)
  upiId                String    @default("")
  holderName           String    @default("")
  bankName             String    @default("")
  accountNumber        String    @default("")
  ifsc                 String    @default("")
  branch               String    @default("")
  instructions         String    @default("")
  taxBps               Int?
  taxMode              String?
  deliveryPaise        Int?
  reservationMinutes   Int?
  lateReviewMinutes    Int?
  customerCancelUnpaid Boolean?
  adminCancelUnpaid    Boolean?
  adminCancelPaid      Boolean?
  confirmedById        String?
  confirmedAt          DateTime? @db.Timestamptz(3)
  version              Int       @default(0)
}

model SalesOrder {
  id                     String              @id @default(cuid())
  number                 String              @unique @default(dbgenerated("('FIX-SO-'::text || (nextval('fixup_so_number'::regclass))::text)"))
  requestId              String              @unique
  payloadDigest          String
  customerId             String
  customer               Customer            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  category               CustomerCategory
  customerSnapshot       Json
  addressSnapshot        Json
  paymentDetails         Json
  cancellationRules      Json
  pricingSource          Json
  taxMode                String
  taxBps                 Int
  subtotalPaise          Int
  taxPaise               Int
  deliveryPaise          Int
  totalPaise             Int
  reservationMinutes     Int
  lateReviewMinutes      Int
  reservationExpiresAt   DateTime            @db.Timestamptz(3)
  paymentMethod          String
  status                 String              @default("PENDING_PAYMENT")
  paymentStatus          String              @default("UNPAID")
  lateReviewRequired     Boolean             @default(false)
  overpaymentResolved    Boolean             @default(false)
  refundDecisionRequired Boolean             @default(false)
  notes                  String              @default("")
  internalNotes          String              @default("")
  version                Int                 @default(0)
  cancelledAt            DateTime?           @db.Timestamptz(3)
  cancelledById          String?
  createdAt              DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(3)
  lines                  SalesOrderLine[]
  reservations           StockReservation[]
  submissions            PaymentSubmission[]
  payments               PaymentRecord[]
  events                 SalesOrderEvent[]
  dispatch               Dispatch?

  @@index([customerId, createdAt])
  @@index([status, paymentStatus, createdAt])
}

model SalesOrderLine {
  id             String            @id @default(cuid())
  orderId        String
  order          SalesOrder        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  variantId      String
  variant        ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  productName    String
  variantName    String
  sku            String?
  packSize       String
  imageUrl       String?
  quantity       Int
  unitPricePaise Int
  linePricePaise Int
  taxPaise       Int
  reservation    StockReservation?
  dispatchLine   DispatchLine?

  @@unique([orderId, variantId])
}

model Dispatch {
  id                 String          @id @default(cuid())
  number             String          @unique @default(dbgenerated("('FIX-DSP-'::text || (nextval('fixup_dispatch_number'::regclass))::text)"))
  orderId            String          @unique
  order              SalesOrder      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  requestId          String          @unique
  payloadDigest      String
  method             String
  status             String          @default("DRAFT")
  deliveryStatus     String          @default("PENDING")
  packageCount       Int
  scheduledDate      DateTime        @db.Date
  expectedDate       DateTime?       @db.Date
  personName         String          @default("")
  personPhone        String          @default("")
  vehicleNumber      String          @default("")
  instructions       String          @default("")
  courierName        String          @default("")
  courierService     String          @default("")
  awb                String          @default("")
  awbKey             String?         @unique
  bookingDate        DateTime?       @db.Date
  shippingReference  String          @default("")
  trackingTemplate   String          @default("")
  internalRemarks    String          @default("")
  version            Int             @default(0)
  createdById        String
  confirmedById      String?
  confirmedAt        DateTime?       @db.Timestamptz(3)
  deliveredAt        DateTime?       @db.Timestamptz(3)
  recipientName      String          @default("")
  confirmationSource String          @default("")
  createdAt          DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(3)
  lines              DispatchLine[]
  events             DeliveryEvent[]
  proofs             DeliveryProof[]
}

model DispatchLine {
  id          String               @id @default(cuid())
  dispatchId  String
  dispatch    Dispatch             @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  orderLineId String               @unique
  orderLine   SalesOrderLine       @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  quantity    Int
  allocations DispatchAllocation[]

  @@unique([dispatchId, orderLineId])
}

model DispatchAllocation {
  id             String           @id @default(cuid())
  dispatchLineId String
  line           DispatchLine     @relation(fields: [dispatchLineId], references: [id], onDelete: Restrict)
  lotId          String
  lot            StockLot         @relation(fields: [lotId], references: [id], onDelete: Restrict)
  quantity       Int
  movement       StockMovement?
  returns        DispatchReturn[]
  cost           DispatchCost?

  @@unique([dispatchLineId, lotId])
}

// Approved recorded-lot method: integer rational net purchase cost, excluding separately recorded tax.
model LotCost {
  lotId            String   @id
  lot              StockLot @relation(fields: [lotId], references: [id], onDelete: Restrict)
  numeratorPaise   BigInt
  denominatorUnits Int
  source           String
  sourceReference  String
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
}

model DispatchCost {
  allocationId     String             @id
  allocation       DispatchAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  amountPaise      BigInt?
  numeratorPaise   BigInt?
  denominatorUnits Int?
  source           String
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
}

model BusinessExpense {
  id            String              @id @default(cuid())
  requestId     String              @unique
  payloadDigest String
  title         String
  category      String
  amountPaise   Int
  expenseDate   DateTime            @db.Date
  paymentMethod String
  reference     String              @default("")
  description   String              @default("")
  status        String              @default("ACTIVE")
  version       Int                 @default(0)
  createdById   String
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)
  revisions     ExpenseRevision[]
  attachments   ExpenseAttachment[]

  @@index([expenseDate, category, status])
}

model ExpenseRevision {
  id            String          @id @default(cuid())
  expenseId     String
  expense       BusinessExpense @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  version       Int
  requestId     String          @unique
  payloadDigest String
  title         String
  category      String
  amountPaise   Int
  expenseDate   DateTime        @db.Date
  paymentMethod String
  reference     String
  description   String
  status        String
  actorId       String
  reason        String
  createdAt     DateTime        @default(now()) @db.Timestamptz(3)

  @@unique([expenseId, version])
  @@index([expenseDate, createdAt])
}

model ExpenseAttachment {
  id           String          @id @default(cuid())
  expenseId    String
  expense      BusinessExpense @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  requestId    String          @unique
  fileBytes    Bytes
  fileHash     String
  fileSize     Int
  originalName String
  uploadedById String
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)

  @@index([expenseId])
}

model DeliveryEvent {
  id              String   @id @default(cuid())
  dispatchId      String
  dispatch        Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  requestId       String   @unique
  payloadDigest   String
  kind            String
  status          String
  message         String
  reason          String
  internalRemarks String   @default("")
  reference       String   @default("")
  actorId         String
  occurredAt      DateTime @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([dispatchId, createdAt])
}

model DeliveryProof {
  id                 String   @id @default(cuid())
  dispatchId         String
  dispatch           Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  requestId          String   @unique
  fileBytes          Bytes
  fileHash           String
  fileSize           Int
  mimeType           String
  originalName       String
  source             String
  sharedWithCustomer Boolean  @default(false)
  uploadedById       String
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  @@index([dispatchId])
}

model DispatchReturn {
  id            String             @id @default(cuid())
  allocationId  String
  allocation    DispatchAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  requestId     String             @unique
  payloadDigest String
  quantity      Int
  condition     String
  reference     String
  reason        String
  receivedAt    DateTime           @db.Timestamptz(3)
  actorId       String
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  movement      StockMovement?

  @@index([allocationId])
}

model StockReservation {
  id          String             @id @default(cuid())
  orderId     String
  order       SalesOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderLineId String             @unique
  line        SalesOrderLine     @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  variantId   String
  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity    Int
  status      String             @default("ACTIVE")
  expiresAt   DateTime?          @db.Timestamptz(3)
  changedById String?
  reason      String
  version     Int                @default(0)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  events      ReservationEvent[]

  @@unique([orderId, variantId])
  @@index([variantId, status])
  @@index([status, expiresAt])
}

model ReservationEvent {
  id             String           @id @default(dbgenerated("(gen_random_uuid())::text"))
  reservationId  String
  reservation    StockReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  variantId      String
  variant        ProductVariant   @relation(fields: [variantId], references: [id], onDelete: Restrict)
  version        Int
  previousStatus String?
  status         String
  quantityDelta  Int
  expiresAt      DateTime?        @db.Timestamptz(3)
  actorId        String?
  reason         String
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)

  @@unique([reservationId, version])
  @@index([variantId, createdAt])
}

model PaymentSubmission {
  id                 String         @id @default(cuid())
  requestId          String         @unique
  payloadDigest      String
  orderId            String
  order              SalesOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  submittedById      String
  submittedBy        User           @relation(fields: [submittedById], references: [id], onDelete: Restrict)
  method             String
  reference          String
  referenceKey       String
  paidOn             DateTime       @db.Date
  remarks            String         @default("")
  imageBytes         Bytes
  imageHash          String
  imageSize          Int
  width              Int
  height             Int
  originalName       String
  duplicateReference Boolean        @default(false)
  late               Boolean        @default(false)
  status             String         @default("SUBMITTED")
  version            Int            @default(0)
  reviewedById       String?
  reviewedAt         DateTime?      @db.Timestamptz(3)
  internalNotes      String         @default("")
  publicMessage      String         @default("")
  createdAt          DateTime       @default(now()) @db.Timestamptz(3)
  payment            PaymentRecord?

  @@index([referenceKey])
  @@index([status, createdAt])
}

model PaymentRecord {
  id            String             @id @default(cuid())
  requestId     String             @unique
  payloadDigest String
  orderId       String
  order         SalesOrder         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  submissionId  String?            @unique
  submission    PaymentSubmission? @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  kind          String
  method        String
  amountPaise   Int
  bankReference String
  referenceKey  String             @unique
  verifiedById  String
  verifiedBy    User               @relation(fields: [verifiedById], references: [id], onDelete: Restrict)
  notes         String
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
}

model SalesOrderEvent {
  id            String     @id @default(cuid())
  orderId       String
  order         SalesOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  kind          String
  message       String
  internalNotes String     @default("")
  actorId       String?
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)

  @@index([orderId, createdAt])
}
