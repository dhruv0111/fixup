generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  DEALER
  SALES_REP
  ADMIN
  SUPER_ADMIN
}

enum DealerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(CUSTOMER)
  active        Boolean   @default(true)
  profileProvisionedAt DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  customer      Customer?
  auditLogs     AuditLog[]
  dealerReviews DealerProfile[] @relation("DealerReviewer")

  @@index([role, active])
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Required by Better Auth: credential passwords are library-managed here, not in User.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@index([expiresAt])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model Customer {
  id           String   @id @default(cuid())
  userId       String   @unique
  businessName String?
  phone        String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  addresses    Address[]
  dealer       DealerProfile?
}

model Address {
  id         String   @id @default(cuid())
  customerId String
  recipient  String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String   @default("IN")
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model DealerProfile {
  id             String       @id @default(cuid())
  customerId     String       @unique
  businessName   String
  contactName    String
  businessType   String?
  gstin          String?      @unique
  expectedVolume String?
  status         DealerStatus @default(PENDING)
  reviewedById   String?
  reviewedAt     DateTime?     @db.Timestamptz(3)
  reviewReason   String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  reviewedBy     User?         @relation("DealerReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reviewedById])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  reason     String?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

model BusinessSettings {
  id          String   @id @default("singleton")
  displayName String   @default("FIXUP")
  timezone    String   @default("Asia/Kolkata")
  currency    String   @default("INR")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

model Category {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String @default("")
  active Boolean @default(true)
  isDemo Boolean @default(false)
  products Product[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Product {
  id String @id @default(cuid())
  name String
  slug String @unique
  sku String @unique
  brand String
  packSize String
  summary String
  description String
  active Boolean @default(true)
  published Boolean @default(false)
  featured Boolean @default(false)
  isDemo Boolean @default(false)
  contentApproved Boolean @default(false)
  approvalReference String @default("")
  applications String[] @default([])
  materials String[] @default([])
  specifications Json @default("[]")
  storageInstructions String @default("")
  availability String @default("ENQUIRE")
  categoryId String
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images ProductImage[]
  documents ProductDocument[]
  enquiries Enquiry[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([active, published, isDemo])
  @@index([categoryId])
}

model ProductImage {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url String
  alt String
  approved Boolean @default(false)
  sortOrder Int @default(0)
  @@index([productId])
}

model ProductDocument {
  id String @id @default(cuid())
  productId String
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  title String
  kind String
  publicUrl String?
  privateReference String @default("")
  approved Boolean @default(false)
  visibility String @default("PRIVATE")
  @@index([productId])
}

model WebsiteContent {
  id String @id @default("singleton")
  phone String @default("")
  whatsapp String @default("")
  email String @default("")
  address String @default("")
  workingHours String @default("")
  aboutText String @default("")
  aboutApproved Boolean @default(false)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Faq {
  id String @id @default(cuid())
  question String
  answer String
  published Boolean @default(false)
  sortOrder Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Policy {
  id String @id
  title String
  body String
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model Enquiry {
  id String @id @default(cuid())
  requestId String @unique
  payloadDigest String
  kind String
  name String
  businessName String @default("")
  phone String
  email String @default("")
  address String @default("")
  city String @default("")
  postalCode String @default("")
  businessType String @default("")
  gstin String @default("")
  quantity String @default("")
  location String @default("")
  message String @default("")
  consentAt DateTime @default(now()) @db.Timestamptz(3)
  productId String?
  product Product? @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([kind, createdAt])
}
